logging {
  level  = "info"
  format = "json"
}

loki.relabel "faro_logs" {
    forward_to = [loki.write.local.receiver]

    rule {
        source_labels = ["app_name"]
        target_label  = "service_name"
    }

    rule {
        action = "labeldrop"
        regex  = "app_name"
    }
}

faro.receiver "integrations_app_agent_receiver" {
    server {
        listen_address           = "0.0.0.0"
        listen_port              = 12347
        max_allowed_payload_size = "2MiB"

        rate_limiting {
            rate = 100
        }
    }

    sourcemaps {
      /*download_from_origins = ["https://immersion-tracker.ethnatpf.com"]*/
    }

    // Empty values copy the corresponding Faro payload fields into labels.
    extra_log_labels = { "kind" = "", "app_name" = "" }

    output {
        logs   = [loki.relabel.faro_logs.receiver]
        traces = [otelcol.exporter.otlp.tempo.input]
    }
}

otelcol.receiver.otlp "traces" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  retry_on_failure {
    max_elapsed_time = "1m0s"
  }

  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

loki.source.file "backend" {
  targets = [{
    __path__     = "/var/log/backend/backend.log",
    service_name = "immersion-tracker-api",
  }]
  forward_to = [loki.process.backend.receiver]

  file_match {
    enabled     = true
    sync_period = "5s"
  }
}

loki.process "backend" {
  // Nest CLI compilation and watch messages are not application JSON logs.
  stage.json {
    // Expression is not to map the log fields, it's to extract fields so that we can use them in following stages.
    expressions = {
      level     = "level",
      timestamp = "timestamp",
    }
    drop_malformed = true
  }

  stage.timestamp {
    source            = "timestamp"
    format            = "UnixMs"
    action_on_failure = "skip"
  }

  stage.labels {
    // Empty string means to use the same field name as the label. We extracted the level value above.
    values = { level = "" }
  }

  // Request IDs and other request fields stay in JSON, not indexed labels.
  stage.label_keep {
    values = ["service_name", "level"]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
