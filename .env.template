MONGODB_URL="mongodb://localhost/immersion-tracker"
MONGODB_TEST_URL="mongodb://localhost/immersion-tracker-test"
AUTH_ISSUER_BASE_URL=https://auth.ethnatpf.com/
AUTH_AUDIENCE=https://immersion-tracker-api.ethnatpf.com
# Frontend origin (scheme, host, and port; no path or trailing slash).
# Cross-origin access is disabled when unset.
FRONTEND_URL=http://localhost:3000
# Arbitrary token used to authenticate the metrics endpoint for prometheus.
METRICS_TOKEN=

# HTTP traces exported to local Alloy. Set OTEL_SDK_DISABLED=true to disable.
OTEL_SERVICE_NAME=immersion-tracker-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SDK_DISABLED=false
